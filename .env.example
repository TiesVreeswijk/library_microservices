# Copy this file to .env and change the values.
# Without a .env file, docker-compose.yml falls back to these same defaults.

# Postgres superuser (only used by the init script and for admin work)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# One password per service database
BOOK_DB_PASSWORD=book_password
MEMBER_DB_PASSWORD=member_password
LOAN_DB_PASSWORD=loan_password

# Clients must send this in the X-Api-Key header to use the gateway
GATEWAY_API_KEY=dev-api-key

# Circuit breaker in the gateway, one per service. The circuit opens when at least
# CIRCUIT_FAILURE_RATIO of the calls in the last CIRCUIT_SAMPLING_SECONDS failed (and there
# were at least CIRCUIT_MINIMUM_THROUGHPUT calls), and stays open for CIRCUIT_BREAK_SECONDS.
CIRCUIT_FAILURE_RATIO=0.5
CIRCUIT_MINIMUM_THROUGHPUT=4
CIRCUIT_SAMPLING_SECONDS=10
CIRCUIT_BREAK_SECONDS=15

# Demo only: make the Book Service slow (milliseconds) or fail (0.5 = half of the requests).
# 0 means off. Apply a change with: docker compose up -d book-service
BOOK_FAULT_DELAY_MS=0
BOOK_FAULT_FAILURE_RATE=0
