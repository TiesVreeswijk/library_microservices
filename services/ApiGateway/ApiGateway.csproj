<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Routing, HttpClient and health checks are all part of ASP.NET Core.
       The gateway has no database of its own. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- Polly for HttpClient: the timeout and the circuit breaker on every call to a service. -->
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.11.0" />
  </ItemGroup>

</Project>
