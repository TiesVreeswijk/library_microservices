{
  "info": {
    "_postman_id": "7c2251ea-3e2f-5583-8c40-d73251b1c1c7",
    "name": "Library microservices demo",
    "description": "Every request of docs/DEMO.md, grouped per scenario. Set the collection variables baseUrl and apiKey if yours differ. The API key is sent as X-Api-Key on every request (collection auth); the gateway has no login.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "apikey",
    "apikey": [
      {
        "key": "key",
        "value": "X-Api-Key",
        "type": "string"
      },
      {
        "key": "value",
        "value": "{{apiKey}}",
        "type": "string"
      },
      {
        "key": "in",
        "value": "header",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    },
    {
      "key": "apiKey",
      "value": "dev-api-key"
    }
  ],
  "item": [
    {
      "name": "Scenario 1. Normal flow",
      "description": "API Gateway (routing + API key), API Composition, Database per Service.",
      "item": [
        {
          "name": "Health (no key needed)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "Healthy. /health is open so Docker can call it.",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Books without API key -> 401",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/books",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "books"
              ]
            },
            "description": "The gateway stops it before any service sees it.",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Books with API key",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/books",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "books"
              ]
