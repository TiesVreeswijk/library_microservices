            "description": "7 books, forwarded to the Book Service as GET /books."
          }
        },
        {
          "name": "Loans of Anna (only ids)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/loans?memberId=1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
